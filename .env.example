# URL ending in /parabank/services/bank; use only a controlled, isolated instance.
BASE_URL=http://localhost:8080/parabank/services/bank
# Optional whitelist for private test hostnames/IPs. Comma-separated exact values.
ALLOWED_HOSTS=localhost,127.0.0.1
# Campaign settings. Durations are seconds; defaults are intentionally short for local smoke runs.
PROFILE=smoke
DURATION_SECONDS=30
RAMP_SECONDS=5
USERS=2
RATE_PER_SECOND=2
DATA_DIR=data
# Local isolated ParaBank web port (bound only to loopback).
PARABANK_PORT=8080
