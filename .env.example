# URL ending in /parabank/services/bank; use only a controlled, isolated instance.
BASE_URL=http://localhost:8080/parabank/services/bank
# Optional whitelist for private test hostnames/IPs. Comma-separated exact values.
ALLOWED_HOSTS=localhost,127.0.0.1
# Campaign settings. Durations are seconds; defaults are intentionally short for local smoke runs.
PROFILE=smoke
DURATION_SECONDS=30
RAMP_SECONDS=5
USERS=2
RATE_PER_SECOND=2
DATA_DIR=data
# Think time of the closed-model scenarios, in seconds. Zero during smoke.
PAUSE_SECONDS=3
LOAN_PAUSE_SECONDS=5
# Feeder sizes. A load campaign reuses the CSV when it wraps around, so these only need to cover
# the variety of data, not every single request.
TRANSFER_ROWS=60000
PAYMENT_ROWS=24000
LOAN_ROWS=12000
# Local isolated ParaBank web port (bound only to loopback).
PARABANK_PORT=8080
